# 语言（A8）—— 不要在代码里硬编码，从这里读
COGNIWORK_DEFAULT_LOCALE=en-US
COGNIWORK_FALLBACK_LOCALE=en-US
# JSON 数组。生产保持 en-US 为交付基线。
# COGNIWORK_SUPPORTED_LOCALES=["en-US","zh-CN"]

# memory = 进程内（无 Postgres 的本地启动 / 单测默认）
# postgres = 生产与 CI 的路径，需要可连的 Postgres（本地可用 apps/backend/docker-compose.yml）并跑迁移
COGNIWORK_STORE_BACKEND=postgres
COGNIWORK_DATABASE_URL=postgresql://cogniwork:cogniwork@localhost:5432/cogniwork
COGNIWORK_REDIS_URL=redis://localhost:6379/0
COGNIWORK_DEBUG=false

# 认证与脱敏。生产必须换成足够长的随机值（见 docs/deploy.md §4.1）。
COGNIWORK_JWT_SECRET=dev-only-change-me-not-for-production!!
COGNIWORK_JWT_TTL_SECONDS=604800
COGNIWORK_IP_HASH_PEPPER=dev-only-change-me

# 连接器凭据信封加密主密钥。丢失则已存 token 无法解密。
COGNIWORK_VAULT_MASTER_KEY=dev-only-vault-master-key-change-me!!

# API 公网根 URL（无尾斜杠）。OAuth redirect_uri = {该值}/api/v1/tools/oauth/callback
COGNIWORK_PUBLIC_BASE_URL=http://localhost:8000
# JSON 数组。OAuth 成功后跳到第一项。生产写成实际页面源。
COGNIWORK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 生产必须 false。true 时连接器走桩，不会访问真实供应商。
COGNIWORK_OAUTH_STUB=false

# Scope 注册表等配置位置（默认自动向上查找仓库里的 config/）
# COGNIWORK_SCOPES_PATH=/path/to/config/scopes.yaml
# COGNIWORK_MIGRATIONS_PATH=/path/to/apps/backend/migrations
# COGNIWORK_MODEL_ROUTES_PATH=/path/to/config/model_routes.yaml
# COGNIWORK_TOOL_CATALOG_PATH=/path/to/config/tool_catalog.yaml
# COGNIWORK_SKILL_PRESETS_PATH=/path/to/config/skill_presets.yaml
# COGNIWORK_TASK_TEMPLATES_PATH=/path/to/config/task_templates.yaml
# COGNIWORK_INTERVIEW_PATH=/path/to/config/interview_question.yaml

# Agent Runtime。auto = 有密钥用内置模型，没有则 stub（xlsx→周报仍能跑通）
COGNIWORK_LLM_PROVIDER=auto
# COGNIWORK_ANTHROPIC_API_KEY=
# COGNIWORK_OPENAI_API_KEY=
COGNIWORK_MAX_UPLOAD_BYTES=20971520
COGNIWORK_TASK_STEP_LIMIT=25
COGNIWORK_TASK_COST_USD_LIMIT=0.50
COGNIWORK_DAILY_COST_USD_LIMIT=5.00
COGNIWORK_MEMORY_BUDGET_TOKENS=2000
# 全局在飞 LLM 调用上限。per-(user, provider) 令牌桶管不到跨用户总量。
COGNIWORK_LLM_GLOBAL_CONCURRENCY=16

# MCP 传输形态。stdio = 连接器独立进程（生产默认，崩溃不带上 API）。
# inprocess 只给单测：子进程拿不到测试注入的 transport。其它值启动即报错。
COGNIWORK_MCP_TRANSPORT=stdio

# 连接器 OAuth 客户端。回调 URL 必须与 PUBLIC_BASE_URL 拼出的 redirect_uri 一致。
# COGNIWORK_GOOGLE_CLIENT_ID=
# COGNIWORK_GOOGLE_CLIENT_SECRET=
# COGNIWORK_NOTION_CLIENT_ID=
# COGNIWORK_NOTION_CLIENT_SECRET=
# COGNIWORK_GITHUB_CLIENT_ID=
# COGNIWORK_GITHUB_CLIENT_SECRET=
