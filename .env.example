# 语言（A8）—— 不要在代码里硬编码，从这里读
COGNIWORK_DEFAULT_LOCALE=en-US
COGNIWORK_FALLBACK_LOCALE=en-US

# memory = 进程内（无 Postgres 的本地启动 / 单测默认）
# postgres = 生产路径，需先起 docker compose 并跑迁移
COGNIWORK_STORE_BACKEND=postgres
COGNIWORK_DATABASE_URL=postgresql://cogniwork:cogniwork@localhost:5432/cogniwork
COGNIWORK_REDIS_URL=redis://localhost:6379/0
COGNIWORK_DEBUG=false

# 认证。生产环境必须换成足够长的随机值。
COGNIWORK_JWT_SECRET=dev-only-change-me-not-for-production!!
COGNIWORK_IP_HASH_PEPPER=dev-only-change-me

# Scope 注册表位置（默认自动向上查找 config/scopes.yaml）
# COGNIWORK_SCOPES_PATH=/path/to/config/scopes.yaml
# COGNIWORK_MIGRATIONS_PATH=/path/to/apps/backend/migrations
